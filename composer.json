{
  "name": "techstore/legacy",
  "description": "Local teaching application for software maintenance exercises.",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "TechStore\\": "src/"
    },
    "files": [
      "src/Support/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "TechStore\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
